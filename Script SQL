CREATE SCHEMA IF NOT EXISTS `bd_cadastro` DEFAULT CHARACTER SET utf8 ;
USE `bd_cadastro` ;

CREATE TABLE IF NOT EXISTS `bd_cadastro`.`tb_cadastro` (
  `pkidcadastro` INT NOT NULL AUTO_INCREMENT,
  `nome` VARCHAR(255) NOT NULL,
  `idade` INT NOT NULL,
  `rua` VARCHAR(255) NOT NULL,
  `numero` INT NOT NULL,
  `cidade` VARCHAR(255) NOT NULL,
  PRIMARY KEY (`pkidcadastro`))
ENGINE = InnoDB
DEFAULT CHARACTER SET = utf8;
